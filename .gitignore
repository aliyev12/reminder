# ----------------------------------------------------------------------
# Build Artifacts & Binaries
# ----------------------------------------------------------------------
# Binary name matches your module name
/scheduler

# General binaries and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries (built with `go test -c`)
*.test

# Output of the go coverage tool
*.out
coverage.txt

# ----------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------
# Vendor directory (ignore if you are not checking in vendor)
vendor/

# Go workspace file
go.work
go.work.sum

# ----------------------------------------------------------------------
# SQLite & GORM (Specific to your stack)
# ----------------------------------------------------------------------
# Ignore local database files to prevent committing data
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# ----------------------------------------------------------------------
# IDE & OS Files
# ----------------------------------------------------------------------
# Mac
.DS_Store

# Windows
Thumbs.db

# VS Code
.vscode/

# JetBrains (GoLand)
.idea/
*.iml

# ----------------------------------------------------------------------
# Environment & Logs
# ----------------------------------------------------------------------
# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Logs (common with Echo server outputs)
*.log
logs/